<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>A Legião — Você agora faz parte da Legião</title>
<meta name="description" content="Uma comunidade de pessoas que decidiram sair do comum e construir uma nova versão de si mesmas. Cadastre-se e entre para A Legião.">
<meta name="theme-color" content="#050505">
<meta property="og:title" content="A Legião — Você agora faz parte da Legião">
<meta property="og:description" content="Uma comunidade de pessoas que decidiram sair do comum e construir uma nova versão de si mesmas.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23050505'/%3E%3Cpath d='M16 18l8 12 8-12 8 12 8-12v22H16z' fill='%23E01825'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
 --k:#050505;--k2:#101010;--r:#B5121B;--r2:#E01825;--w:#FFFFFF;--g:#A1A1A6;
 --ln:rgba(255,255,255,.12);--pad:clamp(20px,4vw,56px);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;background:var(--k)}
body{background:var(--k);color:var(--w);font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-weight:400;font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
img,svg{display:block}
:focus-visible{outline:2px solid var(--r2);outline-offset:4px}
.serif{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;text-transform:uppercase;line-height:1.02;letter-spacing:.01em}
.red{color:var(--r2)}
.wrap{position:relative;max-width:1280px;margin:0 auto;padding:0 var(--pad)}

/* topo */
.top{position:relative;z-index:5}
.top .wrap{display:flex;justify-content:space-between;align-items:center;height:96px}
.brand{display:flex;align-items:center;gap:16px;font-size:14px;font-weight:500;letter-spacing:.44em;text-transform:uppercase}
.brand svg{width:34px;height:34px}
.top nav{display:flex;gap:30px;font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--g)}
.top nav a:hover{color:var(--w)}

/* hero: a foto ocupa a largura inteira, como na referência */
.hero{position:relative;min-height:1000px;text-align:center;overflow:hidden;isolation:isolate}
.hero:before{content:"";position:absolute;left:50%;top:52%;width:min(120vw,1100px);aspect-ratio:1;transform:translate(-50%,-50%);background:radial-gradient(closest-side,rgba(181,18,27,.38),rgba(181,18,27,.1) 55%,transparent 75%);z-index:0;pointer-events:none;animation:breathe 9s ease-in-out infinite}
@keyframes breathe{0%,100%{opacity:.75}50%{opacity:1}}
.art{position:absolute;left:0;top:96px;width:100%;height:auto;z-index:1;pointer-events:none;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 14%,#000 72%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0,#000 14%,#000 72%,transparent 100%);animation:emerge 2.4s cubic-bezier(.2,.7,.2,1) both}
@keyframes emerge{from{opacity:0;transform:scale(1.03)}to{opacity:1;transform:none}}
.hero-txt{position:relative;z-index:3;padding-top:4px;margin-top:-40px}
.kicker{font-size:12px;font-weight:500;letter-spacing:.4em;text-transform:uppercase;color:var(--w)}
.kicker i{font-style:normal;color:var(--r2);margin:0 14px;letter-spacing:0}
.rule{display:block;width:1px;height:44px;margin:24px auto 0;background:linear-gradient(180deg,var(--r2),transparent)}
.hero h1{margin-top:22px;font-size:clamp(44px,6vw,88px);line-height:1.02;text-shadow:0 2px 30px rgba(0,0,0,.6)}
.hero h1 span{display:block;color:var(--r2)}
.sub{margin:24px auto 0;max-width:620px;font-size:clamp(16px,1.5vw,18px);font-weight:500;line-height:1.7;color:var(--w);text-shadow:0 2px 20px rgba(0,0,0,.8)}
.pillars{position:absolute;inset:0;z-index:3;pointer-events:none}
.pl{position:absolute;display:flex;flex-direction:column;align-items:flex-start;gap:12px;text-align:left;width:250px;pointer-events:auto}
.pl svg{width:30px;height:30px;stroke:var(--r2);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.pl h3{font-size:14px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;line-height:1.45}
.pl p{font-size:14px;color:var(--g);line-height:1.6}
.p1{left:9%;top:40%}.p2{left:9%;top:58%}
.p3{right:9%;top:40%}.p4{right:9%;top:58%}

/* segunda dobra */
.after{position:relative;margin-top:0;padding:clamp(64px,8vw,110px) 0 0;text-align:center;z-index:2}
.after .eyebrow{font-size:12px;font-weight:500;letter-spacing:.36em;text-transform:uppercase;color:var(--g)}
.after h2{margin-top:18px;font-size:clamp(40px,5vw,72px)}
.after h2 .red{font-style:normal}
.after p{margin:20px auto 0;max-width:520px;color:var(--g);font-size:16px;line-height:1.7}

/* cadastro */
.cad{padding:0;margin-top:0}
.card{max-width:560px;margin:0 auto;background:var(--k2);border:1px solid var(--ln);border-radius:6px;padding:clamp(34px,4vw,50px) clamp(26px,4vw,48px)}
.card h2{font-size:22px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;text-align:center;line-height:1.3}
.card .intro{margin-top:12px;text-align:center;font-size:14px;color:var(--g);line-height:1.6}
form{display:grid;gap:14px;margin-top:30px}
.field{position:relative}
.field svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);width:18px;height:18px;stroke:var(--g);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
.field input{width:100%;height:54px;background:#0a0a0a;border:1px solid #232323;border-radius:4px;color:var(--w);font:400 15px Inter,sans-serif;padding:0 16px 0 46px;transition:border-color .25s,background .25s}
.field input::placeholder{color:#6f6f75}
.field input:focus{outline:none;border-color:var(--r2);background:#0d0d0d}
.field.err input{border-color:var(--r2)}
.er{display:none;color:#ff6a64;font-size:12.5px;margin-top:6px}
.field.err .er{display:block}
.btn{width:100%;height:56px;margin-top:10px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:linear-gradient(90deg,var(--r) 0%,var(--r2) 100%);color:var(--w);border:0;border-radius:4px;font:600 14px Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:filter .25s,transform .25s}
.btn:hover{filter:brightness(1.12);transform:translateY(-1px)}
.btn[disabled]{filter:grayscale(1);cursor:wait;transform:none}
.btn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.safe{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:20px;font-size:12.5px;color:var(--g)}
.safe svg{width:14px;height:14px;stroke:var(--g);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
#fail{display:none;color:#ff6a64;font-size:14px;text-align:center;margin-top:14px}
.ok{display:none;text-align:center;padding:10px 0}
.ok h3{font-size:24px;letter-spacing:.14em;text-transform:uppercase;font-weight:600}
.ok p{margin-top:12px;color:var(--g)}
.consent{max-width:560px;margin:22px auto 0;display:flex;gap:12px;align-items:flex-start;font-size:13px;color:var(--g);line-height:1.6;cursor:pointer}
.consent input{margin-top:4px;width:16px;height:16px;accent-color:var(--r2);flex:none}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}

/* rodapé */
footer{margin-top:clamp(64px,8vw,100px);border-top:1px solid var(--ln);padding:34px 0}
footer .wrap{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px;font-size:13px;color:var(--g)}
footer .brand{font-size:12px;letter-spacing:.4em}
footer .brand svg{width:26px;height:26px}
footer .mid{text-align:center}
footer nav{display:flex;gap:26px;justify-content:flex-end}
footer nav a:hover{color:var(--w)}

/* legal */
.legal{padding:clamp(64px,8vw,100px) 0 0}
.legal .wrap{max-width:720px}
.legal h2{font-size:clamp(30px,3.4vw,40px);margin-top:44px;text-align:left}
.legal h2:first-child{margin-top:0}
.legal h3{font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;margin:28px 0 8px}
.legal p,.legal li{font-size:15px;color:var(--g);margin-top:8px}
.legal ul{padding-left:18px}
.legal b{color:var(--w);font-weight:600}
.legal [id]{scroll-margin-top:30px}

/* revelação */
.js .rv{opacity:0;transform:translateY(14px);transition:opacity 1s ease,transform 1s ease}
.js .rv.on{opacity:1;transform:none}

/* faixa infinita logo abaixo da headline (da direita para a esquerda) */
.marquee-wrap{position:relative;z-index:3;padding:14px 0 6px}
.marquee{position:relative;width:100vw;margin:0 calc(50% - 50vw);overflow:hidden;white-space:nowrap;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.mq-track{display:inline-flex;width:max-content;animation:mq 26s linear infinite;will-change:transform}
.mq-track span{display:block;padding-right:56px;font-family:Inter,system-ui,sans-serif;font-weight:500;font-size:clamp(13px,1.3vw,17px);letter-spacing:.08em;text-transform:uppercase;color:#FF1F2A;line-height:1.4;text-shadow:0 0 18px rgba(255,31,42,.35)}
@keyframes mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
/* formulário do Google Forms incorporado */
.gform{display:block;width:100%;height:880px;border:0;border-radius:6px;background:#fff}
/* formulário sobe até a base da foto (somente desktop) */
@media(min-width:1001px){.cad{margin-top:-160px;position:relative;z-index:4}}
/* responsivo */
@media(max-width:1000px){
 .top nav{display:none}
 .float{display:none}
 .hero{min-height:0;padding-bottom:40px}
 .art{position:relative;top:auto;margin-top:-10px}
 .hero-txt{margin-top:-120px}
 .pillars{position:relative;inset:auto;display:grid;grid-template-columns:1fr 1fr;gap:34px 24px;padding:24px var(--pad) 0;max-width:720px;margin:0 auto}
 .pl{position:relative;inset:auto;width:auto;left:auto;right:auto;top:auto}
}
@media(max-width:620px){
 .pillars{grid-template-columns:1fr}
 .hero-txt{margin-top:-80px}
 .card{padding:30px 22px}
 footer .wrap{grid-template-columns:1fr;text-align:center}
 footer nav{justify-content:center;flex-wrap:wrap}
 .after{margin-top:-30px}
}
/* pilares: desktop fica como antes; celular vira carrossel infinito arrastável e fino */
.clone{display:none}
.ticker{display:contents}
@media(max-width:620px){
 .clone{display:block}
 .pillars{display:block;position:relative;inset:auto;max-width:none;margin:0 calc(-1*var(--pad));padding:6px 0 4px;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x}
 .pillars::-webkit-scrollbar{display:none}
 .ticker{display:flex;gap:10px;width:max-content;padding:0 var(--pad)}
 .pillars .pl{position:relative;inset:auto;flex:0 0 auto;width:150px;max-width:none;gap:4px;padding:10px 12px;border:1px solid var(--ln);border-radius:6px;background:rgba(255,255,255,.02);user-select:none}
 .pl svg{width:14px;height:14px;stroke-width:1.8}
 .pl h3{font-size:9.5px;letter-spacing:.12em;line-height:1.3}
 .pl p{font-size:10px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.mq-track{animation:none!important}.ticker{animation:none!important}.pillars{overflow-x:auto}.hero:before,.stage img{animation:none!important}.js .rv{opacity:1;transform:none;transition:none}.btn{transition:none}}
</style>
</head>
<body>
<script>document.documentElement.classList.add("js")</script>

<header class="top"><div class="wrap">
 <a class="brand" href="#" aria-label="A Legião, início">
  <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M4 8l8 10 8-10 8 10 8-10v18H4z" fill="#E01825"/><path d="M4 26h32" stroke="#E01825" stroke-width="2"/></svg>
  A Legião
 </a>
 <nav aria-label="Principal"><a href="#cadastro">Disciplina</a><a href="#cadastro">Estratégia</a><a href="#cadastro">Liberdade</a></nav>
</div></header>

<main>
<div class="marquee-wrap"><div class="marquee" role="marquee" aria-label="Agora você faz parte dessa Legião. Você está prestes a entrar no 1% das pessoas que pensam, mas apenas milionários têm coragem de agir."><div class="mq-track"><span>Agora você faz parte dessa Legião. Você está prestes a entrar no 1% das pessoas que pensam, mas apenas milionários têm coragem de agir.</span><span aria-hidden="true">Agora você faz parte dessa Legião. Você está prestes a entrar no 1% das pessoas que pensam, mas apenas milionários têm coragem de agir.</span></div></div></div>
<section class="hero" aria-labelledby="h1">
 <img class="art" src="data:image/webp;base64," width="1024" height="1536" fetchpriority="high"
      alt="Homem de máscara preta, camisa social vinho e gravata preta, sentado com os braços abertos e as palmas voltadas para cima, em um ambiente escuro com luz vermelha.">

 <div class="wrap hero-txt">
  <span class="rule" aria-hidden="true"></span>
  <h1 class="serif" id="h1">Você agora faz parte<span>da Legião.</span></h1>
  
  <p class="sub">Uma comunidade de pessoas que decidiram sair do comum<br>e construir uma nova versão de si mesmas.</p>
 </div>

 <div class="pillars" aria-label="Pilares da Legião" tabindex="0"><div class="ticker">
  <div class="pl p1 rv"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="11"/><path d="M16 5v22M5 16h22M9 9c3 2 3 12 0 14M23 9c-3 2-3 12 0 14"/></svg><h3>Conhecimento<br>estratégico</h3><p>Aprenda conceitos e ferramentas que podem te ajudar a tomar decisões melhores.</p></div>
  <div class="pl p2 rv"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 26h24M7 22V16M13 22V11M19 22V14M25 22V8"/></svg><h3>Evolução<br>contínua</h3><p>Construa hábitos, desenvolva competências e transforme conhecimento em ação.</p></div>
  <div class="pl p3 rv"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="10"/><circle cx="16" cy="16" r="4"/><path d="M16 2v4M16 26v4M2 16h4M26 16h4"/></svg><h3>Negócios<br>e marketing</h3><p>Explore estratégias de posicionamento, criação de conteúdo, vendas e negócios digitais.</p></div>
  <div class="pl p4 rv"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="7" y="14" width="18" height="13" rx="2"/><path d="M11 14V10a5 5 0 0110 0v4"/></svg><h3>Novas<br>oportunidades</h3><p>Receba informações sobre materiais, projetos e oportunidades disponibilizados pela Legião.</p></div>
  <div class="pl p1 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="11"/><path d="M16 5v22M5 16h22M9 9c3 2 3 12 0 14M23 9c-3 2-3 12 0 14"/></svg><h3>Conhecimento<br>estratégico</h3><p>Aprenda conceitos e ferramentas que podem te ajudar a tomar decisões melhores.</p></div>
  <div class="pl p2 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 26h24M7 22V16M13 22V11M19 22V14M25 22V8"/></svg><h3>Evolução<br>contínua</h3><p>Construa hábitos, desenvolva competências e transforme conhecimento em ação.</p></div>
  <div class="pl p3 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="10"/><circle cx="16" cy="16" r="4"/><path d="M16 2v4M16 26v4M2 16h4M26 16h4"/></svg><h3>Negócios<br>e marketing</h3><p>Explore estratégias de posicionamento, criação de conteúdo, vendas e negócios digitais.</p></div>
  <div class="pl p4 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="7" y="14" width="18" height="13" rx="2"/><path d="M11 14V10a5 5 0 0110 0v4"/></svg><h3>Novas<br>oportunidades</h3><p>Receba informações sobre materiais, projetos e oportunidades disponibilizados pela Legião.</p></div>
  <div class="pl p1 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="11"/><path d="M16 5v22M5 16h22M9 9c3 2 3 12 0 14M23 9c-3 2-3 12 0 14"/></svg><h3>Conhecimento<br>estratégico</h3><p>Aprenda conceitos e ferramentas que podem te ajudar a tomar decisões melhores.</p></div>
  <div class="pl p2 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 26h24M7 22V16M13 22V11M19 22V14M25 22V8"/></svg><h3>Evolução<br>contínua</h3><p>Construa hábitos, desenvolva competências e transforme conhecimento em ação.</p></div>
  <div class="pl p3 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="10"/><circle cx="16" cy="16" r="4"/><path d="M16 2v4M16 26v4M2 16h4M26 16h4"/></svg><h3>Negócios<br>e marketing</h3><p>Explore estratégias de posicionamento, criação de conteúdo, vendas e negócios digitais.</p></div>
  <div class="pl p4 clone" aria-hidden="true"><svg viewBox="0 0 32 32" aria-hidden="true"><rect x="7" y="14" width="18" height="13" rx="2"/><path d="M11 14V10a5 5 0 0110 0v4"/></svg><h3>Novas<br>oportunidades</h3><p>Receba informações sobre materiais, projetos e oportunidades disponibilizados pela Legião.</p></div>
 </div>
 </div>

 <div class="float f1" aria-hidden="true"></div>
 <div class="float f2" aria-hidden="true"></div>
 <div class="float f3" aria-hidden="true"></div>
 <div class="float f4" aria-hidden="true"></div>
</section>

<section class="cad" id="cadastro" aria-labelledby="fh"><div class="wrap rv">
 <div class="card">
  <h2 id="fh">Entre para a Legião</h2>
  <p class="intro">Preencha seus dados e receba conteúdos exclusivos e novidades sobre o projeto.</p>
  <iframe class="gform" src="https://docs.google.com/forms/d/e/1FAIpQLSelC7VPIFQFttPEtBgVPClgJ8DYmdGfCUup_zF8dGLGFHmphQ/viewform?embedded=true" title="Formulário de cadastro da Legião" loading="lazy" allow="clipboard-write">Carregando formulário…</iframe>
  <p class="safe"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>Seus dados estão 100% seguros.</p>
</div>

</div></section>

<section class="after" aria-labelledby="mh"><div class="wrap rv">
 <p class="eyebrow">O mundo não vai esperar.</p>
 <h2 class="serif" id="mh">E você também <span class="red">não.</span></h2>
 <p>O próximo capítulo da sua vida não vai acontecer por acaso. Ele começa com uma decisão.</p>
</div></section>



<section class="legal" id="legal" aria-label="Informações legais"><div class="wrap">
 <h2 class="serif" id="privacidade">Política de Privacidade</h2>
 <p><small>Modelo inicial. Revise com um profissional jurídico e preencha os dados do controlador antes de divulgar.</small></p>
 <h3>Quem trata seus dados</h3><p>A Legião, responsável pelo tratamento (controlador). Contato: <b>[preencher e-mail de contato]</b>.</p>
 <h3>Quais dados coletamos e para quê</h3>
 <ul><li><b>Nome e e-mail:</b> para registrar seu cadastro e enviar informações sobre o projeto.</li><li><b>WhatsApp (opcional):</b> para contato, e para comunicações promocionais somente se você consentir.</li><li><b>Preferência de consentimento e data:</b> para comprovar sua escolha sobre comunicações promocionais.</li></ul>
 <p>Coletamos apenas o necessário. Os eventos de acesso medidos (visualização, cliques e envios) não incluem dados pessoais.</p>
 <h3>Base legal, armazenamento e retenção</h3><p>Execução do cadastro solicitado por você e, para comunicações promocionais, seu consentimento (caixa separada, nunca pré-marcada). Os dados ficam em banco de dados com controle de acesso e são mantidos enquanto o projeto existir ou até você pedir a exclusão. <b>[ajustar prazo, se houver]</b></p>
 <h3>Seus direitos</h3><p>Conforme a LGPD, você pode pedir confirmação do tratamento, acesso, correção, exclusão, portabilidade e revogação do consentimento a qualquer momento, pelo contato acima. Seus dados não são vendidos; podem ser processados por provedores de hospedagem e banco de dados necessários ao funcionamento da página.</p>
 <h2 class="serif" id="termos">Termos de Uso</h2>
 <p>Esta página tem caráter informativo e de cadastro. O conteúdo da Legião não promete resultados financeiros ou atalhos; os resultados dependem da dedicação de cada pessoa. O conteúdo é protegido por direitos autorais e não pode ser copiado sem autorização. Os termos podem ser alterados, e vale a versão publicada nesta página.</p>
</div></section>
</main>

<footer><div class="wrap">
 <a class="brand" href="#" aria-label="A Legião, início">
  <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M4 8l8 10 8-10 8 10 8-10v18H4z" fill="#E01825"/><path d="M4 26h32" stroke="#E01825" stroke-width="2"/></svg>
  A Legião
 </a>
 <span class="mid">© <span id="ano">2026</span> A Legião. Todos os direitos reservados.</span>
 <nav aria-label="Rodapé"><a href="#privacidade">Política de Privacidade</a><a href="#termos">Termos de Uso</a></nav>
</div></footer>

<script>
(function(){
  document.getElementById("ano").textContent = new Date().getFullYear();
  const rv = document.querySelectorAll(".rv");
  if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches){
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting){ e.target.classList.add("on"); io.unobserve(e.target); } }), {threshold:.12});
    rv.forEach(el => io.observe(el));
  } else rv.forEach(el => el.classList.add("on"));
})();
</script>
<script>
/* carrossel infinito arrastável (celular) */
(function(){
  const box = document.querySelector('.pillars');
  if (!box) return;
  const tk = box.querySelector('.ticker');
  const mq = matchMedia('(max-width: 620px)');
  let W = 0;
  function measure(){
    const cards = tk.children;
    W = cards[4] ? cards[4].offsetLeft - cards[0].offsetLeft : 0;
  }
  function init(){ measure(); if (mq.matches && W) box.scrollLeft = W; }
  box.addEventListener('scroll', () => {
    if (!mq.matches || !W) return;
    if (box.scrollLeft < W * 0.5) box.scrollLeft += W;
    else if (box.scrollLeft > W * 1.5) box.scrollLeft -= W;
  }, {passive:true});
  let t; addEventListener('resize', () => { clearTimeout(t); t = setTimeout(init, 150); });
  if (document.readyState === 'complete') init(); else addEventListener('load', init);
})();
</script>
</body>
</html>
